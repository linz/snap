# Mappings for include-what-you-use, in addition to boost-all.imp (see the iwyu target in build.py).
#
# The C library's names (FILE, printf, sqrt) are not mapped here. The sources write them with std::,
# which is why IWYU suggests the C++ headers (<cstdio>, <cmath>). A name written without std:: makes
# it ask for the C header (<stdio.h>), and mapping entries for such names were tried without effect.
[
  # std::array is declared in <array>, not <tuple>.
  { "symbol": ["std::array", "private", "<array>", "public"] }
]
